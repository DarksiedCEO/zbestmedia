DATABASE_URL="postgresql://user:pass@localhost:5433/artifact_registry"
PORT=8082
SERVICE_NAME="artifact-registry"

# Optional NATS connection for the event outbox. Omit to disable publishing.
# NATS_URL="nats://localhost:4222"

# Fail-closed service auth. The server refuses to boot without this.
# JSON array of identities: keyId, an opaque bearer token, and the workspaces
# each token may act on ("*" = any workspace, for trusted internal callers).
# Callers send: Authorization: Bearer <token>. GET routes also send
# x-workspace-id: <workspace>; POST routes carry workspaceId in the body.
SERVICE_AUTH_TOKENS='[{"keyId":"local-dev","token":"dev-token-change-me","tenants":["*"]}]'
