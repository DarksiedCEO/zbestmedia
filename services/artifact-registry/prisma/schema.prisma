generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artifact {
  artifactId           String    @id @map("artifact_id")
  workspaceId          String    @map("workspace_id")
  brandId              String    @map("brand_id")
  requestId            String    @map("request_id")
  artifactType         String    @map("artifact_type")
  artifactVersion      String    @map("artifact_version")
  attempt              Int
  inputHash            String    @map("input_hash")
  payload              Json
  meta                 Json
  evalReport           Json?     @map("eval_report")
  supersedesArtifactId String?   @map("supersedes_artifact_id")
  immutableAt          DateTime? @map("immutable_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, artifactType, createdAt], map: "idx_artifacts_workspace_type_created")
  @@index([brandId, artifactType, createdAt], map: "idx_artifacts_brand_type_created")
  @@index([requestId], map: "idx_artifacts_request")
  @@index([supersedesArtifactId], map: "idx_artifacts_supersedes")
  @@map("artifacts")
}

model ArtifactLineageEdge {
  fromArtifactId String   @map("from_artifact_id")
  toArtifactId   String   @map("to_artifact_id")
  edgeType       String   @map("edge_type")
  createdAt      DateTime @default(now()) @map("created_at")

  @@id([fromArtifactId, toArtifactId, edgeType])
  @@index([toArtifactId], map: "idx_lineage_to")
  @@map("artifact_lineage_edges")
}

model EventOutbox {
  id             String    @id // deterministic event id and broker de-duplication key
  subject        String
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")
  attemptCount   Int       @default(0) @map("attempt_count")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  terminalAt     DateTime? @map("terminal_at")
  lastRetryClass String?   @map("last_retry_class")
  lastError      String?   @map("last_error")

  @@index([publishedAt, terminalAt, nextAttemptAt], map: "idx_event_outbox_due")
  @@index([leaseExpiresAt], map: "idx_event_outbox_lease")
  @@map("event_outbox")
}
