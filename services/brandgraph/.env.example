DATABASE_URL="file:./prisma/dev.db"

# Fail-closed service auth. The server refuses to boot without this.
# JSON array of identities: keyId, an opaque bearer token, and the tenants
# each token may act on ("*" = any tenant, for trusted internal callers).
# Callers send: Authorization: Bearer <token>  and  x-tenant-id: <tenant>
SERVICE_AUTH_TOKENS='[{"keyId":"local-dev","token":"dev-token-change-me","principalId":"local-dev","subject":"service:local-dev","audiences":["brandgraph"],"scopes":["brand:*"],"tenants":["*"],"issuedAt":"2026-01-01T00:00:00.000Z","notBefore":"2026-01-01T00:00:00.000Z","expiresAt":"2027-01-01T00:00:00.000Z","status":"ACTIVE","generation":1}]'
SERVICE_AUTH_ALLOWED_PRINCIPALS="local-dev"
