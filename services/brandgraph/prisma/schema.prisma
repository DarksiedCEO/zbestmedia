generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  brands Brand[]
}

model Brand {
  id        String   @id
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, name])
}

model GraphEvent {
  id        String   @id
  tenantId  String
  brandId   String?
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([brandId])
  @@index([createdAt])
}
