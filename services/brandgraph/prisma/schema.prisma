generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  brands Brand[]
  manifests AgentManifest[]
  rotationAudits RotationAudit[]
}

model Brand {
  id        String   @id
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, name])
}

model GraphEvent {
  id        String   @id
  tenantId  String
  brandId   String?
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([brandId])
  @@index([createdAt])
}

enum AgentStatus {
  ACTIVE
  RETIRED
  DISABLED
}

model AgentManifest {
  agentId          String     @id
  tenantId         String
  ownerDomain      String
  role             String
  version          String
  status           AgentStatus @default(ACTIVE)
  createdAt        DateTime    @default(now())
  expiresAt        DateTime
  memoryNamespace  String
  successorAgentId String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@index([ownerDomain])
}

model RotationAudit {
  id               String      @id @default(cuid())
  tenantId         String
  agentId          String
  fromStatus       AgentStatus
  toStatus         AgentStatus
  successorAgentId String?
  reason           String
  createdAt        DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, agentId])
}
