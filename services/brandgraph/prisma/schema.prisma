generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  @@index([name])
}

model GraphEvent {
  id        String   @id
  brandId   String
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([createdAt])
}
