generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./test.db"
}

model Tenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  manifests AgentManifest[]
  rotationAudits RotationAudit[]
}

model Brand {
  id        String   @id
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@unique([tenantId, name])
}

model GraphEvent {
  id        String   @id
  tenantId  String
  brandId   String?
  eventType String
  payload   String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([brandId])
  @@index([createdAt])
}

model AgentManifest {
  agentId          String     @id
  tenantId         String
  ownerDomain      String
  role             String
  version          String
  status           String @default("ACTIVE")
  createdAt        DateTime    @default(now())
  expiresAt        DateTime
  memoryNamespace  String
  successorAgentId String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@index([ownerDomain])
}

model RotationAudit {
  id               String      @id @default(cuid())
  tenantId         String
  agentId          String
  fromStatus       String
  toStatus         String
  successorAgentId String?
  reason           String
  createdAt        DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, agentId])
}
