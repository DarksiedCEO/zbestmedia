{
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1
    },
    "eventVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "artifactId": {
      "$ref": "#/properties/eventId"
    },
    "reportId": {
      "$ref": "#/properties/eventId"
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "eventId",
    "occurredAt",
    "eventVersion",
    "artifactId",
    "reportId",
    "reasonCodes"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
