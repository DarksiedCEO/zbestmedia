{
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1
    },
    "eventVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "brandId": {
      "$ref": "#/properties/eventId"
    },
    "period": {
      "type": "object",
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "$ref": "#/properties/period/properties/startDate"
        }
      },
      "required": [
        "startDate",
        "endDate"
      ],
      "additionalProperties": false
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "channel",
          "metric",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "eventId",
    "occurredAt",
    "eventVersion",
    "brandId",
    "period",
    "signals"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
