{
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1
    },
    "eventVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "artifactId": {
      "$ref": "#/properties/eventId"
    },
    "requestId": {
      "$ref": "#/properties/eventId"
    },
    "directive": {
      "type": "object",
      "properties": {
        "regen": {
          "type": "boolean"
        },
        "maxAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "strategy": {
          "type": "string",
          "enum": [
            "tune",
            "rewrite",
            "style-shift",
            "content-augment"
          ]
        },
        "focusAreas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "regen",
        "maxAttempts",
        "strategy",
        "focusAreas"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "occurredAt",
    "eventVersion",
    "artifactId",
    "requestId",
    "directive"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
