{
  "name": "@zbest/artifacts-api",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "db"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "db:up": "docker compose -f db/docker-compose.postgres.yml up -d",
    "db:down": "docker compose -f db/docker-compose.postgres.yml down -v",
    "db:wait": "node db/scripts/wait-for-db.js",
    "db:migrate:check": "node db/scripts/resolve-db-url.js",
    "db:migrate": "node db/scripts/migrate.js",
    "db:migrate:local": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zbestmedia_artifacts pnpm db:migrate",
    "start": "node --import tsx src/main.ts"
  },
  "dependencies": {
    "@zbest/agent-os": "workspace:*",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "canonicalize": "^2.1.0",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.1.3",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
