{
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "$ref": "#/properties/meta/properties/artifactId"
        },
        "artifactType": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "lineage": {
          "type": "object",
          "properties": {
            "parentArtifactIds": {
              "type": "array",
              "items": {
                "$ref": "#/properties/meta/properties/artifactId"
              }
            },
            "sourceEventId": {
              "$ref": "#/properties/meta/properties/artifactId"
            },
            "attempt": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "parentArtifactIds",
            "sourceEventId",
            "attempt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "artifactId",
        "requestId",
        "artifactType",
        "schemaVersion",
        "lineage"
      ],
      "additionalProperties": false
    },
    "brandId": {
      "$ref": "#/properties/meta/properties/artifactId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "timeRange": {
      "type": "object",
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "$ref": "#/properties/timeRange/properties/startDate"
        }
      },
      "required": [
        "startDate",
        "endDate"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "$ref": "#/properties/timeRange/properties/startDate"
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "assetType": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "channel",
          "topic",
          "assetType"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "brandId",
    "title",
    "summary",
    "timeRange",
    "items"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
