{
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "$ref": "#/properties/meta/properties/artifactId"
        },
        "artifactType": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "lineage": {
          "type": "object",
          "properties": {
            "parentArtifactIds": {
              "type": "array",
              "items": {
                "$ref": "#/properties/meta/properties/artifactId"
              }
            },
            "sourceEventId": {
              "$ref": "#/properties/meta/properties/artifactId"
            },
            "attempt": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "parentArtifactIds",
            "sourceEventId",
            "attempt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "artifactId",
        "requestId",
        "artifactType",
        "schemaVersion",
        "lineage"
      ],
      "additionalProperties": false
    },
    "brandId": {
      "$ref": "#/properties/meta/properties/artifactId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "campaignId": {
      "$ref": "#/properties/meta/properties/artifactId"
    },
    "narrativeArc": {
      "type": "string",
      "minLength": 1
    },
    "keyMessages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proofPoints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "meta",
    "brandId",
    "title",
    "summary",
    "narrativeArc",
    "keyMessages",
    "proofPoints"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
