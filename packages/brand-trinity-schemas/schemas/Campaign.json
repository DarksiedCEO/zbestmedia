{
  "type": "object",
  "properties": {
    "campaignId": {
      "type": "string",
      "minLength": 1
    },
    "brandId": {
      "$ref": "#/properties/campaignId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "$ref": "#/properties/startDate"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "paused",
        "completed"
      ]
    }
  },
  "required": [
    "campaignId",
    "brandId",
    "name",
    "objective",
    "startDate",
    "endDate",
    "status"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
