{
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "$ref": "#/properties/artifactId"
    },
    "artifactType": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parentArtifactIds": {
          "type": "array",
          "items": {
            "$ref": "#/properties/artifactId"
          }
        },
        "sourceEventId": {
          "$ref": "#/properties/artifactId"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "parentArtifactIds",
        "sourceEventId",
        "attempt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifactId",
    "requestId",
    "artifactType",
    "schemaVersion",
    "lineage"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
