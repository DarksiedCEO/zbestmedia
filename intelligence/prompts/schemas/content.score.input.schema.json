{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zbestmedia.content.score.input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "text", "target", "constraints"],
  "properties": {
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "platform": { "type": "string", "minLength": 2 },
    "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "maxChars"],
      "properties": {
        "tone": { "type": "string", "minLength": 2 },
        "maxChars": { "type": "integer", "minimum": 1, "maximum": 5000 }
      }
    }
  }
}
