{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zbestmedia.content.rewrite.input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "text", "constraints"],
  "properties": {
    "platform": { "type": "string", "minLength": 2 },
    "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "maxChars"],
      "properties": {
        "tone": { "type": "string", "minLength": 2 },
        "maxChars": { "type": "integer", "minimum": 1, "maximum": 5000 }
      }
    }
  }
}
