{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zbestmedia.agent-os.execution.output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "actions", "risks", "approvalRequired", "handoffTarget", "evidence"],
  "properties": {
    "summary": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 3, "maxLength": 500 }
    },
    "risks": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 3, "maxLength": 500 }
    },
    "approvalRequired": { "type": "boolean" },
    "handoffTarget": {
      "type": ["string", "null"],
      "enum": ["brandyn", "jordyn", "kobe", "oracle", "titan", "maestro", null]
    },
    "evidence": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 3, "maxLength": 500 }
    }
  }
}
