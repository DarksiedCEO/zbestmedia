{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zbestmedia.research.summarize.output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string", "minLength": 20, "maxLength": 2000 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail", "evidenceIds"],
        "properties": {
          "title": { "type": "string", "minLength": 5, "maxLength": 120 },
          "detail": { "type": "string", "minLength": 20, "maxLength": 1000 },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
