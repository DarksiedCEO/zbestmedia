{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zbestmedia.governance.riskcheck.input.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyPackId", "category", "text"],
  "properties": {
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "policyPackId": { "type": "string", "minLength": 1 }
      }
    },
    "policyPackId": { "type": "string", "minLength": 3, "maxLength": 80 },
    "category": { "type": "string", "minLength": 3, "maxLength": 80 },
    "text": { "type": "string", "minLength": 1, "maxLength": 5000 }
  }
}
