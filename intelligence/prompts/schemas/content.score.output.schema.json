{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zbestmedia.content.score.output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["score", "signals", "warnings", "recommendations"],
  "properties": {
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "signals": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": "number" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1 }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
