{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zbestmedia.governance.safeRewrite.output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyPackId", "rewrites"],
  "properties": {
    "policyPackId": { "type": "string", "minLength": 3 },
    "rewrites": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "mitigatedRiskCodes", "reasoning"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
          "mitigatedRiskCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "enum": ["CLAIM_GUARANTEE", "CLAIM_SUPERLATIVE", "CLAIM_UNVERIFIABLE", "LEGAL_ADVICE"]
            }
          },
          "reasoning": { "type": "string", "minLength": 10, "maxLength": 500 }
        }
      }
    }
  }
}
