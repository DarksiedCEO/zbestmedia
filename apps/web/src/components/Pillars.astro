---
type Pillar = { title: string; body: string };
type Props = { heading: string; items: Pillar[] };
const { heading, items } = Astro.props;
---

<section class="mt-10 grid gap-4">
  <h2 class="text-2xl font-semibold">{heading}</h2>
  <div class="grid gap-4 md:grid-cols-4">
    {items.map((item) => (
      <div class="rounded-xl border border-border bg-panel p-5">
        <div class="h-1 w-9 bg-gold rounded-full mb-4"></div>
        <h3 class="font-semibold">{item.title}</h3>
        <p class="text-muted text-sm mt-2">{item.body}</p>
      </div>
    ))}
  </div>
</section>
