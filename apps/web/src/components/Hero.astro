---
type Props = {
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
};

const { title, body, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="grid gap-8 md:grid-cols-12 items-start">
  <div class="md:col-span-6 grid gap-5">
    <h1 class="text-4xl md:text-5xl leading-[1.02] font-semibold">{title}</h1>
    <p class="text-muted max-w-[60ch]">{body}</p>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href={primaryHref} class="rounded-xl bg-gold px-5 py-3 text-bg font-semibold">{primaryLabel}</a>
      <a href={secondaryHref} class="rounded-xl border border-border px-5 py-3 text-text">{secondaryLabel}</a>
    </div>
    <slot name="left" />
  </div>

  <div class="md:col-span-6">
    <slot name="right" />
  </div>
</section>
