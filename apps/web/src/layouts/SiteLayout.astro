---
import "../styles/global.css";
import { organizationSchema, softwareAppSchema } from "@zbest/content";
import Footer from "../components/Footer.astro";
import { buildMeta } from "../lib/meta";

type Props = {
  title: string;
  description: string;
  path: string;
};

const { title, description, path } = Astro.props;
const meta = buildMeta({ title, description, path });
const org = organizationSchema();
const app = softwareAppSchema();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.url} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(org)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(app)} />
  </head>
  <body class="bg-bg text-text">
    <header class="border-b border-border/80">
      <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between gap-4">
        <a href="/" class="font-semibold tracking-wide">Z Best Media</a>

        <nav class="hidden md:flex items-center gap-6 text-sm text-muted">
          <a class="hover:text-text" href="/platform">Platform</a>
          <a class="hover:text-text" href="/governance">Governance</a>
          <a class="hover:text-text" href="/security">Security</a>
          <a class="hover:text-text" href="/solutions">Solutions</a>
          <a class="hover:text-text" href="/docs">Docs</a>
          <a class="hover:text-text" href="/contact">Contact</a>
        </nav>

        <div class="flex items-center gap-3">
          <a class="hidden lg:inline text-sm text-muted hover:text-text" href="tel:+12136328384">(213) 632-8384</a>
          <a class="hidden lg:inline text-sm text-muted hover:text-text" href="mailto:hello@zbestmedia.com">
            hello@zbestmedia.com
          </a>
          <a href="/contact" class="rounded-xl bg-gold px-4 py-2 text-bg font-semibold text-sm">Book a Strategic Brief</a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-10">
      <slot />
    </main>

    <Footer />
  </body>
</html>
