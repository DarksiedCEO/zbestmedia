    "riskOwner": "Simone",
    "riskEscalation": ["Andre Love"],
    "sendingEnabled": false
  },
  "executionIsolation": {
    "sharedWritableOwnershipAllowed": false,
    "businessAgentsMayMutateEngineeringCode": false,
    "engineeringAgentsMayMutateBusinessPolicy": false,
    "crossRepositoryMutationAllowed": false,
    "handoffOnly": true
  },
  "businessTaskRequiredFields": ["taskId","businessObjective","owner","department","revenueImpact","expectedFounderHoursSaved","dueDate","allowedActions","prohibitedActions","sourceInputs","approvalRequirements","evidence","status","exactBlocker"],
  "businessToEngineeringRequiredFields": ["handoffId","businessObjective","currentManualBurden","founderHoursConsumedPerWeek","requiredCapability","acceptanceCriteria","permittedScope","prohibitedScope","privacyImpact","securityImpact","expectedFounderHoursSaved","expectedRevenueImpact","requestedBy","submittedAt","approvalClaim","authorizationDecision","verificationStatus","externalVerificationRequired"],
  "approvalClaimPolicy": {
    "trustedSignerAvailable": false,
    "trustedApprovalLedgerAvailable": false,
    "claimIsAuthorization": false,
    "requiredAuthorizationDecision": "DO_NOT_EXECUTE",
    "requiredVerificationStatus": "PENDING_HUMAN_VERIFICATION",
    "externalVerificationRequired": true,
    "trustedReceiptIssuer": "Andre Love or an out-of-band trusted verifier",
    "receiptStorage": "Outside this package",
    "claimRefVerificationStatus": "UNVERIFIED",
    "digestBindingStatus": "UNVERIFIED",
    "compatibilityBoolean": "approvedByAndre is optional, non-authoritative, and never sufficient",
    "chronology": "claimedApprovedAt, when present, must be timezone-aware RFC3339 and no later than submittedAt; submittedAt must not be in the future"
  },
  "founderBrief": {
