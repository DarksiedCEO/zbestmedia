    "irreversibleActionPermittedByDefault": false
  },
  "liveActionPermissions": {
    "send": false,
    "publish": false,
    "schedule": false,
    "contact": false,
    "message": false,
    "mutate": false
  },
  "capabilityPolicy": {
    "externalEffects": {
      "requiredDenied": ["send","publish","schedule","contact","message","mutate"],
      "allowed": []
