{
  "schemaVersion": "1.0.0",
  "authority": {
    "canonicalBusinessFacts": "Andre Love",
    "operationalOwnershipAndRouting": "business-operations-integration-marshal",
    "engineeringCode": "16 external and separate Engineering Grandmasters",
    "businessPolicy": "Andre Love",
    "autonomyPromotion": "Andre Love",
    "selfApprovalAllowed": false,
    "selfPromotionAllowed": false
  },
  "statuses": ["QUEUED","IN_PROGRESS","READY_FOR_REVIEW","BLOCKED","COMPLETE"],
  "autonomyLevels": ["TESTED","SUPERVISED","BOUNDED_AUTONOMY","PRODUCTION_AUTONOMY"],
  "defaultAutonomy": "SUPERVISED",
  "wipLimits": {
    "activeExecutionBatches": 4,
    "awaitingFounderReview": 2,
    "unresolvedCanonicalFactConflicts": 1,
    "ownersPerProspect": 1,
    "ownersPerClient": 1,
    "ownersPerPublicProfile": 1,
    "activePublishingBatches": 1
  },
  "ownership": {
    "prospect": "Exactly one owner; duplicate outreach planning is prohibited.",
    "client": "Exactly one owner; conflicting communication planning is prohibited.",
    "publicProfile": "Exactly one correction owner.",
    "task": "Exactly one accountable owner."
  },
  "humanApproval": {
    "requiredFor": ["external communication","outreach sending","meeting scheduling","publishing or scheduling","public profile mutation","irreversible action","pricing","discounts","scope changes","contracts","refunds","spend","canonical facts","legal or security response","sensitive-data disclosure","autonomy promotion"],
