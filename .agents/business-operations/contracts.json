    "sensitiveFounderContext": {
      "requiredDenied": ["read-aaliyah-private-memory","write-aaliyah-private-memory","read-founder-private-preferences","write-founder-private-preferences"],
      "allowed": []
    },
    "rolePolicies": {
      "agency-operations-founder-relief-grandmaster": {
        "allowed": ["classify","prioritize","delegate-internally","draft","package","measure-from-evidence","recommend","request-human-approval"],
        "denied": ["send","publish","schedule","contact","message","mutate","read-aaliyah-private-memory","write-aaliyah-private-memory","impersonate-andre","change-pricing","change-business-facts","modify-engineering-code","self-approve","self-promote"]
      },
      "business-operations-integration-marshal": {
        "allowed": ["inspect","classify","assign-internal-ownership","enforce-wip","reject-incomplete-handoff","package-non-code-artifacts","prepare-engineering-request"],
        "denied": ["send","publish","schedule","contact","message","mutate","perform-sales","approve-business-decision","modify-engineering-code","certify-self","self-promote"]
      },
      "revenue-acquisition-grandmaster": {
        "allowed": ["research","classify","draft","prepare-meeting-recommendation","prepare-approved-material","escalate-opportunity"],
        "denied": ["send","publish","schedule","contact","message","mutate","change-price","discount","negotiate-contract","sign-contract","promise-results","fabricate-evidence","modify-engineering-code","self-approve","self-promote"]
      },
      "presence-recovery-grandmaster": {
        "allowed": ["audit","inventory","monitor-read-only","classify","draft-correction","prepare-recommendation","report"],
        "denied": ["send","publish","schedule","contact","message","mutate","submit-public-change","change-canonical-fact","delete-listing","merge-profile","mark-location-closed","modify-engineering-code","self-approve","self-promote"]
      },
      "content-social-operations-grandmaster": {
        "allowed": ["research","brief","draft","adapt","quality-check","queue-for-human-approval","classify-observation"],
        "denied": ["send","publish","schedule","contact","message","mutate","reply-publicly","change-positioning","delete-history","modify-engineering-code","self-approve","self-promote"]
      },
      "client-success-delivery-grandmaster": {
        "allowed": ["classify","route-internally","prepare-checklist","draft-status","track-provided-assets","track-approvals","escalate-for-human-action"],
        "denied": ["send","publish","schedule","contact","message","mutate","admit-liability","alter-scope","approve-refund","waive-charge","sign-contract","close-risk-incident","modify-engineering-code","self-approve","self-promote"]
      }
    }
  },
  "publicClaims": {
    "evidenceRequired": true,
    "unsupportedClaimsProhibited": true,
    "evidenceStates": ["CONFIRMED","STRUCTURED_OBSERVATION","HYPOTHESIS","UNKNOWN","ASSUMPTION","RECOMMENDATION"],
    "hypothesisMayBePresentedAsFact": false
  },
  "founderHoursSaved": {
    "formula": "max(0, documented_baseline_minutes - documented_founder_minutes_after - documented_correction_minutes)",
    "requiredEvidence": ["baseline source","measurement window","founder minutes after","correction minutes","calculation"],
    "targetsAreAccomplishments": false,
    "fabricationProhibited": true
  },
  "privacyBoundary": {
    "aaliyahIncluded": false,
    "aaliyahPrivateMemoryAccess": [],
    "publicRepresentativePrivateFounderAccess": false,
    "founderPrivateInstructionsStored": false
  },
  "emailRouting": {
