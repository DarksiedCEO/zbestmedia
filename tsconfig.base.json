{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "lib": [
      "ES2020"
    ],
    "baseUrl": ".",
    "paths": {
      "@zbest/brand-trinity-schemas": [
        "packages/brand-trinity-schemas/src/index.ts"
      ],
      "@zbest/eval-gates-schemas": [
        "packages/eval-gates-schemas/src/index.ts"
      ],
      "@zbest/brand-events-contracts": [
        "packages/brand-events-contracts/src/index.ts"
      ],
      "@zbest/id-core": [
        "packages/id-core/src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  }
}
